# ============================================================================
# .env.example — copy to .env and adjust (`.env` is git-never-committed)
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL (consumer writes, dashboards read) ---
DATABASE_URL=postgresql+psycopg2://happiness:happiness@localhost:5432/happiness

# --- Kafka (host-side producer/consumer use the EXTERNAL listener) ---
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_TOPIC=happiness-events
CONSUMER_GROUP=happiness-ml-team

# --- Consumer /metrics endpoint (scraped by Prometheus) ---
METRICS_PORT=8000

# --- Optional services (docker-compose profiles) ---
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
# UID used by Airflow containers to write into the mounted repo.
# Rootless Podman (default): leave as 0 — container uid 0 maps to your host uid.
# Rootful Docker/Linux: set to your uid, e.g. AIRFLOW_UID=1000 (id -u)
AIRFLOW_UID=0
